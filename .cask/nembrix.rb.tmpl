cask "nembrix" do
  version "__VERSION__"

  # Per-arch dmgs (no universal build). Homebrew picks the matching
  # arch; the release job fills in each sha256 below.
  on_arm do
    sha256 "__SHA256_ARM__"
    url "https://github.com/__OWNER__/__REPO__/releases/download/v#{version}/Nembrix_#{version}_macOS_Apple_Silicon.dmg",
        verified: "github.com/__OWNER__/__REPO__/"
  end
  on_intel do
    sha256 "__SHA256_X64__"
    url "https://github.com/__OWNER__/__REPO__/releases/download/v#{version}/Nembrix_#{version}_macOS_Intel.dmg",
        verified: "github.com/__OWNER__/__REPO__/"
  end

  name "Nembrix"
  desc "Connect. Query. Control."
  homepage "https://github.com/__OWNER__/__REPO__"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"

  app "Nembrix.app"

  zap trash: [
    "~/Library/Application Support/dev.nembrix.app",
    "~/Library/Preferences/dev.nembrix.app.plist",
    "~/Library/Caches/dev.nembrix.app",
  ]
end

# Local signing material — CSR, exported certs, .p12s. Never commit; the
# .p12 is injected into CI via the APPLE_CERTIFICATE secret instead.
.cert/
.cask/
# Tauri updater private signing key — never commit. Load into CI as the
# TAURI_SIGNING_PRIVATE_KEY secret. The matching pubkey is committed in
# tauri.conf.json (it isn't sensitive); the key files themselves stay out.
.updater-key
.updater-key.pub

# Package manager — this is a yarn workspace. Keep foreign lockfiles out
# so they don't drift against yarn.lock or confuse Dependabot / CI.
package-lock.json
npm-shrinkwrap.json
pnpm-lock.yaml
bun.lockb
bun.lock

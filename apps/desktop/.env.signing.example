# Copy to .env.signing (gitignored) and fill in real values
# before running `yarn build:prod`.
#
# These four are used for LOCAL signed builds. The signing certificate
# itself is read from your macOS Keychain, so it is NOT listed here.
export APPLE_SIGNING_IDENTITY="Developer ID Application: <your name> (<team-id>)"
export APPLE_TEAM_ID="<team-id>"
export APPLE_ID="<your developer apple id email>"
export APPLE_PASSWORD="<app-specific password from appleid.apple.com>"

# ── CI only (GitHub Actions) ────────────────────────────────────────
# CI has no Keychain, so the Developer ID certificate must be injected
# as a base64-encoded .p12 plus its export password. You do NOT set
# these locally — leave them commented here for reference. In CI they
# are stored as the APPLE_CERTIFICATE / APPLE_CERTIFICATE_PASSWORD
# secrets (see docs/release-signing.md). The other four vars above are
# also set as CI secrets with the same names.
# export APPLE_CERTIFICATE="<base64 of DeveloperIDApplication.p12>"
# export APPLE_CERTIFICATE_PASSWORD="<password used when exporting the .p12>"

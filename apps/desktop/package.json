{
  "name": "@nembrix/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sidecar": "tsx scripts/dev-sidecar.ts",
    "dev:all": "concurrently -n vite,sidecar -c blue,magenta \"npm:dev\" \"npm:dev:sidecar\"",
    "build": "tsc -b && vite build",
    "build:prod": "[ -f .env.signing ] && . ./.env.signing; yarn tsc -b --noEmit && yarn test:unit && yarn build && { yarn tauri build || true; } && yarn staple && yarn print-bundles",
    "build:local": "[ -f .env.signing ] && . ./.env.signing; yarn build && yarn tauri build",
    "staple": "tsx scripts/staple.ts",
    "print-bundles": "tsx scripts/print-bundles.ts",
    "release:local": "tsx scripts/release-local.ts",
    "bump-version": "tsx scripts/bump-version.ts",
    "gen-icon": "tsx scripts/gen-icon-source.ts && yarn tauri icon src-tauri/icons/source.png",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-sql": "^6.7.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "express": "^5.2.1",
    "globals": "^17.9.0",
    "pg": "^8.22.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}

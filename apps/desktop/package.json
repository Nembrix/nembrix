{
  "name": "@nembrix/desktop",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sidecar": "tsx scripts/dev-sidecar.ts",
    "dev:all": "concurrently -n vite,sidecar -c blue,magenta \"npm:dev\" \"npm:dev:sidecar\"",
    "build": "tsc -b && vite build",
    "build:prod": "[ -f .env.signing ] && . ./.env.signing; yarn tsc -b --noEmit && yarn test:unit && yarn build && { yarn tauri build || true; } && yarn staple && yarn print-bundles",
    "build:local": "[ -f .env.signing ] && . ./.env.signing; yarn build && yarn tauri build",
    "staple": "tsx scripts/staple.ts",
    "print-bundles": "tsx scripts/print-bundles.ts",
    "release:local": "tsx scripts/release-local.ts",
    "bump-version": "tsx scripts/bump-version.ts",
    "gen-icon": "tsx scripts/gen-icon-source.ts && yarn tauri icon src-tauri/icons/source.png",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-sql": "^6.7.0",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.12",
    "i18next": "^27.1.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

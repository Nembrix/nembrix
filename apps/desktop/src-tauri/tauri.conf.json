{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nembrix",
  "version": "0.5.1",
  "identifier": "com.nembrix.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nembrix",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1c1c20",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/__OWNER__/__REPO__/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRjM5NTAxOUM3QTRFOEUKUldTT1RucWNBWlh6YTc5U3QrVS9ES2RZcjJRZ2NiSmRHaFk4Q0dOSVkzckc0NGtPMXpjejNWUk8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

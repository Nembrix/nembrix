{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@bindings/*": ["bindings/*"]
    }
  },
  // `bindings/` is deliberately excluded: `bindings/commands.ts` is a
  // gitignored build artifact regenerated by the debug-only tauri-specta
  // export, and the 2.0.0-rc generator emits a self-conflicting
  // `export type TAURI_CHANNEL` alongside `import { Channel as TAURI_CHANNEL }`
  // (TS2440). Typechecking it broke `tsc`/`build` locally while CI stayed
  // green — CI never runs cargo, so the file doesn't exist there. Nothing in
  // `src/` imports it; the `@bindings/*` path above still resolves if that
  // changes. Drop this exclusion once tauri-specta stops emitting both.
  "include": ["src", "tests/e2e"]
}

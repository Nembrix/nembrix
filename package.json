{
  "name": "nembrix-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @nembrix/desktop dev",
    "dev:all": "yarn workspace @nembrix/desktop dev:all",
    "build": "yarn workspace @nembrix/desktop build",
    "build:prod": "yarn workspace @nembrix/desktop build:prod",
    "tauri": "yarn workspace @nembrix/desktop tauri",
    "test:unit": "yarn workspace @nembrix/desktop test:unit",
    "test:unit:watch": "yarn workspace @nembrix/desktop test:unit:watch",
    "test:e2e": "yarn workspace @nembrix/desktop test:e2e",
    "test:e2e:install": "yarn workspace @nembrix/desktop test:e2e:install",
    "docs:dev": "yarn workspace @nembrix/docs dev",
    "docs:build": "yarn workspace @nembrix/docs build",
    "docs:preview": "yarn workspace @nembrix/docs preview",
    "docs:media": "tsx scripts/docs/capture.ts",
    "docs:media:audit": "tsx scripts/docs/audit.ts",
    "docs:media:audit:soft": "tsx scripts/docs/audit.ts || true",
    "bump-version": "yarn workspace @nembrix/desktop bump-version",
    "release:local": "yarn workspace @nembrix/desktop release:local",
    "print-bundles": "yarn workspace @nembrix/desktop print-bundles",
    "turbo:build": "turbo run build",
    "turbo:dev": "turbo run dev",
    "turbo:test": "turbo run test:unit",
    "turbo:lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "turbo": "^2.9.18"
  }
}
